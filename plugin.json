{
  "id": "routeliner",
  "name": "Routeliner",
  "version": "0.1.0",
  "description": "Route events and chainage for RustGIS. Routes are assembled from shuffled parts, chainage comes from a ledger with station equations or from control points, and every record that cannot be placed goes to the error table with its reason. The tools compute as the Routeliner plugin for QGIS does.",
  "author": "Inform++ LLC",
  "license": "GPL-3.0-or-later",
  "runtime": "process",
  "session": true,
  "run": { "windows": ["bin/routeliner-rustgis.exe", "rustgis-plugin"] },
  "minRustgisVersion": "0.5.0",
  "commands": [
    { "id": "about", "label": "About\nRouteliner", "help": "About the extension: version, a short description and links.", "icon": "info", "params": "{} (answers the title, the version, text paragraphs and links in the RustGIS language)" }
  ],
  "tools": [
    {"id":"check-routes","name":"1.02 Route check","params":[{"kind":"vectorLayer","label":"Route layer (lines)","name":"routes","required":true},{"default":"route_id","kind":"field","label":"Route ID field","name":"route_id"},{"default":0.01,"kind":"number","label":"Part joint tolerance, m","name":"snap"},{"default":false,"kind":"bool","label":"Allow gaps (a section across a gap comes out as a multi-line)","name":"allow_gaps"},{"default":false,"kind":"bool","label":"3D length (with Z)","name":"use_z"},{"default":false,"kind":"bool","label":"Reverse route direction","name":"reverse"},{"kind":"bool","label":"Errors","name":"errors"}],"summary":"Assembles every route from all features with the same ID.","toolbox":"Routeliner"},
    {"id":"calibrate-routes","name":"1.03 Calibrate routes","params":[{"kind":"vectorLayer","label":"Route layer (lines)","name":"routes","required":true},{"default":"route_id","kind":"field","label":"Route ID field","name":"route_id"},{"default":0.01,"kind":"number","label":"Part joint tolerance, m","name":"snap"},{"default":false,"kind":"bool","label":"Allow gaps (a section across a gap comes out as a multi-line)","name":"allow_gaps"},{"default":false,"kind":"bool","label":"3D length (with Z)","name":"use_z"},{"default":false,"kind":"bool","label":"Reverse route direction","name":"reverse"},{"choices":["ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","Kilometre and metres (км 1+535)","Railway notation (км 12 ПК 3+45)","Metres as a number (1535,5)","Kilometres as a decimal (1,535)"],"default":"ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","kind":"choice","label":"Station notation","name":"format"},{"default":100.0,"kind":"number","label":"Picket length, m","name":"picket"},{"default":0.0,"kind":"number","label":"Route start station (without a ledger), m","name":"start"},{"kind":"layer","label":"Chainage ledger (optional)","name":"ledger"},{"kind":"field","label":"Ledger: route ID field","name":"lg_route"},{"kind":"field","label":"Ledger: station field","name":"lg_station"},{"kind":"numericField","label":"Ledger: distance field (measure along the axis)","name":"lg_measure"},{"kind":"field","label":"Ledger: station ahead field (equation)","name":"lg_ahead"},{"kind":"field","label":"Ledger: chainage system field","name":"lg_system"},{"kind":"text","label":"Chainage system (value of the system field)","name":"system"},{"kind":"pointLayer","label":"Control points with stations (optional)","name":"control"},{"kind":"field","label":"Control points: station field","name":"ct_station"},{"kind":"field","label":"Control points: route ID field (optional)","name":"ct_route"},{"default":10.0,"kind":"number","label":"Search radius for control points, m","name":"ct_radius"},{"choices":["no M","measure along the axis, m","chainage, m"],"default":"chainage, m","kind":"choice","label":"M values of the result","name":"out_m"},{"kind":"bool","label":"Errors","name":"errors"}],"summary":"Assembles the routes and writes M values into their geometry, that is the chainage or the measure along the axis at every vertex.","toolbox":"Routeliner"},
    {"id":"point-events","name":"2.01 Point events","params":[{"kind":"vectorLayer","label":"Route layer (lines)","name":"routes","required":true},{"default":"route_id","kind":"field","label":"Route ID field","name":"route_id"},{"default":0.01,"kind":"number","label":"Part joint tolerance, m","name":"snap"},{"default":false,"kind":"bool","label":"Allow gaps (a section across a gap comes out as a multi-line)","name":"allow_gaps"},{"default":false,"kind":"bool","label":"3D length (with Z)","name":"use_z"},{"default":false,"kind":"bool","label":"Reverse route direction","name":"reverse"},{"kind":"layer","label":"Event table (layer, CSV, Excel)","name":"events","required":true},{"kind":"field","label":"Events: route ID field","name":"ev_route"},{"kind":"field","label":"Events: station field","name":"ev_from"},{"kind":"numericField","label":"Events: offset from the axis field, m","name":"ev_offset"},{"default":false,"kind":"bool","label":"Positive offset to the right of the route direction","name":"offset_right"},{"kind":"numericField","label":"Events: section number field (for backward equations)","name":"ev_section"},{"choices":["ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","Kilometre and metres (км 1+535)","Railway notation (км 12 ПК 3+45)","Metres as a number (1535,5)","Kilometres as a decimal (1,535)"],"default":"ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","kind":"choice","label":"Station notation","name":"format"},{"default":100.0,"kind":"number","label":"Picket length, m","name":"picket"},{"default":0.0,"kind":"number","label":"Route start station (without a ledger), m","name":"start"},{"kind":"layer","label":"Chainage ledger (optional)","name":"ledger"},{"kind":"field","label":"Ledger: route ID field","name":"lg_route"},{"kind":"field","label":"Ledger: station field","name":"lg_station"},{"kind":"numericField","label":"Ledger: distance field (measure along the axis)","name":"lg_measure"},{"kind":"field","label":"Ledger: station ahead field (equation)","name":"lg_ahead"},{"kind":"field","label":"Ledger: chainage system field","name":"lg_system"},{"kind":"text","label":"Chainage system (value of the system field)","name":"system"},{"choices":["no M","measure along the axis, m","chainage, m"],"default":"no M","kind":"choice","label":"M values of the result","name":"out_m"},{"kind":"bool","label":"Errors","name":"errors"}],"summary":"Places table records on the routes by station in the chosen notation, with an offset from the axis.","toolbox":"Routeliner"},
    {"id":"line-events","name":"2.02 Sections (line events)","params":[{"kind":"vectorLayer","label":"Route layer (lines)","name":"routes","required":true},{"default":"route_id","kind":"field","label":"Route ID field","name":"route_id"},{"default":0.01,"kind":"number","label":"Part joint tolerance, m","name":"snap"},{"default":false,"kind":"bool","label":"Allow gaps (a section across a gap comes out as a multi-line)","name":"allow_gaps"},{"default":false,"kind":"bool","label":"3D length (with Z)","name":"use_z"},{"default":false,"kind":"bool","label":"Reverse route direction","name":"reverse"},{"kind":"layer","label":"Event table (layer, CSV, Excel)","name":"events","required":true},{"kind":"field","label":"Events: route ID field","name":"ev_route"},{"kind":"field","label":"Events: start station field","name":"ev_from"},{"kind":"field","label":"Events: end station field","name":"ev_to"},{"kind":"numericField","label":"Events: offset from the axis field, m","name":"ev_offset"},{"default":false,"kind":"bool","label":"Positive offset to the right of the route direction","name":"offset_right"},{"kind":"numericField","label":"Events: section number field (for backward equations)","name":"ev_section"},{"choices":["ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","Kilometre and metres (км 1+535)","Railway notation (км 12 ПК 3+45)","Metres as a number (1535,5)","Kilometres as a decimal (1,535)"],"default":"ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","kind":"choice","label":"Station notation","name":"format"},{"default":100.0,"kind":"number","label":"Picket length, m","name":"picket"},{"default":0.0,"kind":"number","label":"Route start station (without a ledger), m","name":"start"},{"kind":"layer","label":"Chainage ledger (optional)","name":"ledger"},{"kind":"field","label":"Ledger: route ID field","name":"lg_route"},{"kind":"field","label":"Ledger: station field","name":"lg_station"},{"kind":"numericField","label":"Ledger: distance field (measure along the axis)","name":"lg_measure"},{"kind":"field","label":"Ledger: station ahead field (equation)","name":"lg_ahead"},{"kind":"field","label":"Ledger: chainage system field","name":"lg_system"},{"kind":"text","label":"Chainage system (value of the system field)","name":"system"},{"choices":["no M","measure along the axis, m","chainage, m"],"default":"no M","kind":"choice","label":"M values of the result","name":"out_m"},{"kind":"bool","label":"Errors","name":"errors"}],"summary":"Cuts route sections between the start and end stations, with a parallel offset.","toolbox":"Routeliner"},
    {"id":"pickets","name":"4.01 Picket stakeout","params":[{"kind":"vectorLayer","label":"Route layer (lines)","name":"routes","required":true},{"default":"route_id","kind":"field","label":"Route ID field","name":"route_id"},{"default":0.01,"kind":"number","label":"Part joint tolerance, m","name":"snap"},{"default":false,"kind":"bool","label":"Allow gaps (a section across a gap comes out as a multi-line)","name":"allow_gaps"},{"default":false,"kind":"bool","label":"3D length (with Z)","name":"use_z"},{"default":false,"kind":"bool","label":"Reverse route direction","name":"reverse"},{"choices":["ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","Kilometre and metres (км 1+535)","Railway notation (км 12 ПК 3+45)","Metres as a number (1535,5)","Kilometres as a decimal (1,535)"],"default":"ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","kind":"choice","label":"Station notation","name":"format"},{"default":100.0,"kind":"number","label":"Picket length, m","name":"picket"},{"default":0.0,"kind":"number","label":"Route start station (without a ledger), m","name":"start"},{"kind":"layer","label":"Chainage ledger (optional)","name":"ledger"},{"kind":"field","label":"Ledger: route ID field","name":"lg_route"},{"kind":"field","label":"Ledger: station field","name":"lg_station"},{"kind":"numericField","label":"Ledger: distance field (measure along the axis)","name":"lg_measure"},{"kind":"field","label":"Ledger: station ahead field (equation)","name":"lg_ahead"},{"kind":"field","label":"Ledger: chainage system field","name":"lg_system"},{"kind":"text","label":"Chainage system (value of the system field)","name":"system"},{"default":100.0,"kind":"number","label":"Stakeout step, m","name":"step"},{"choices":["no M","measure along the axis, m","chainage, m"],"default":"no M","kind":"choice","label":"M values of the result","name":"out_m"}],"summary":"Places points of whole pickets along every route, with a label and an azimuth for label rotation.","toolbox":"Routeliner"},
    {"id":"locate-points","name":"4.02 Locate points on routes","params":[{"kind":"vectorLayer","label":"Route layer (lines)","name":"routes","required":true},{"default":"route_id","kind":"field","label":"Route ID field","name":"route_id"},{"default":0.01,"kind":"number","label":"Part joint tolerance, m","name":"snap"},{"default":false,"kind":"bool","label":"Allow gaps (a section across a gap comes out as a multi-line)","name":"allow_gaps"},{"default":false,"kind":"bool","label":"3D length (with Z)","name":"use_z"},{"default":false,"kind":"bool","label":"Reverse route direction","name":"reverse"},{"kind":"pointLayer","label":"Points","name":"points","required":true},{"kind":"field","label":"Points: route ID field (optional)","name":"pt_route"},{"default":50.0,"kind":"number","label":"Search radius, m (0 for no limit)","name":"radius"},{"choices":["ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","Kilometre and metres (км 1+535)","Railway notation (км 12 ПК 3+45)","Metres as a number (1535,5)","Kilometres as a decimal (1,535)"],"default":"ПК и плюс (ПК 15+35, 15+35,5, ПК -1+50, +35)","kind":"choice","label":"Station notation","name":"format"},{"default":100.0,"kind":"number","label":"Picket length, m","name":"picket"},{"default":0.0,"kind":"number","label":"Route start station (without a ledger), m","name":"start"},{"kind":"layer","label":"Chainage ledger (optional)","name":"ledger"},{"kind":"field","label":"Ledger: route ID field","name":"lg_route"},{"kind":"field","label":"Ledger: station field","name":"lg_station"},{"kind":"numericField","label":"Ledger: distance field (measure along the axis)","name":"lg_measure"},{"kind":"field","label":"Ledger: station ahead field (equation)","name":"lg_ahead"},{"kind":"field","label":"Ledger: chainage system field","name":"lg_system"},{"kind":"text","label":"Chainage system (value of the system field)","name":"system"},{"kind":"bool","label":"Errors","name":"errors"}],"summary":"The inverse task.","toolbox":"Routeliner"}
  ],
